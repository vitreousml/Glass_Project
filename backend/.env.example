
FIREBASE_PROJECT_ID=glass-composition-platform
FIREBASE_SERVICE_ACCOUNT_PATH=path/to/your/firebase-adminsdk.json
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# --- Admin portal ---
# Emails (comma-separated) that may use the admin portal. Alternatively give an
# account the admin role with: python scripts/grant_admin.py someone@example.com
ADMIN_EMAILS=
# Private Cloud Storage bucket for uploaded model files. Required on Cloud Run,
# whose disk is wiped on restart; leave empty locally to keep files in backend/data.
MODEL_BUCKET=
# firestore (shared, production) or local (a JSON file in backend/data). Empty = Firestore if reachable.
REGISTRY_BACKEND=
